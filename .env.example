# Supabase (values for local development come from `supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payments: `test` (local stand-in, used by `pnpm e2e`) or `dodo` (Dodo Payments)
PAYMENT_PROVIDER=test
# Signs the test provider's webhooks
PAYMENT_WEBHOOK_SECRET=

# Dodo Payments (PAYMENT_PROVIDER=dodo). Test and live modes have separate keys, products and
# webhooks; launch is blocked while DODO_MODE=test.
DODO_MODE=test
DODO_API_KEY=
# The signing secret of the webhook endpoint (whsec_…) that delivers to this environment
DODO_WEBHOOK_SECRET=
# The one-time product with Pay What You Want on; its price is the minimum (= app_config floor or lower)
DODO_PRODUCT_ID=

# Email: resend | test (delivers to the local Mailpit; local and e2e only)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Verified sender, e.g. "Take the Crown <alerts@example.com>"
EMAIL_FROM=
# Signs the "turn off alerts" links in emails (32+ random characters)
EMAIL_LINK_SECRET=

# Moderation: anthropic (claude-haiku-4-5) | test (local and e2e only)
MODERATION_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Cloudflare Turnstile (both empty locally: the check is skipped outside production, and fails
# closed in production without a secret)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Value of the x-origin-secret header a Cloudflare Transform Rule adds (32+ random characters).
# Only with it are Cloudflare's IP and country headers trusted; otherwise Vercel's are used.
CLOUDFLARE_ORIGIN_SECRET=

# Salt for hashing IP addresses (long random string)
IP_HASH_SALT=

# Protects /api/cron/* (sent by Vercel cron as a bearer token)
CRON_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
