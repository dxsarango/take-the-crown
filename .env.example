# Supabase (values for local development come from `supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payments: `test` locally and in e2e; paddle | lemonsqueezy | dodo once approved
PAYMENT_PROVIDER=test
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
# Only for providers that require it (Paddle client token, Lemon Squeezy store id)
PAYMENT_CLIENT_TOKEN=
PAYMENT_STORE_ID=

# Email: resend | test (delivers to the local Mailpit; local and e2e only)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Verified sender, e.g. "Take the Crown <alerts@example.com>"
EMAIL_FROM=
# Signs the "turn off alerts" links in emails (32+ random characters)
EMAIL_LINK_SECRET=

# Moderation: anthropic (claude-haiku-4-5) | test (local and e2e only)
MODERATION_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Salt for hashing IP addresses (long random string)
IP_HASH_SALT=

# Protects /api/cron/* (sent by Vercel cron as a bearer token)
CRON_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
