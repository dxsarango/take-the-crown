{
  "name": "take-the-crown",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:types": "supabase gen types typescript --local > lib/supabase/database.types.ts",
    "test:moderation": "vitest run --project live",
    "secrets:generate": "node scripts/generate-secrets.mjs",
    "check:deploy": "node scripts/check-deployment.mjs",
    "e2e:dodo": "playwright test --config playwright.dodo.config.ts",
    "check:db": "node scripts/database-checks.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@react-email/body": "^0.3.0",
    "@react-email/container": "^0.0.16",
    "@react-email/head": "^0.0.13",
    "@react-email/html": "^0.0.12",
    "@react-email/img": "^0.0.12",
    "@react-email/link": "^0.0.13",
    "@react-email/preview": "^0.0.14",
    "@react-email/render": "^2.1.0",
    "@react-email/section": "^0.0.17",
    "@react-email/text": "^0.1.6",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "16.3.6",
    "next-intl": "^4.14.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "pg": "^8.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
